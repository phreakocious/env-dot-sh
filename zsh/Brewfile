# Core Shell
brew "git"

# The Prompt
brew "starship"

# Modern Unix Tools
brew "eza"        # ls replacement
brew "bat"        # cat replacement
brew "zoxide"     # cd replacement
brew "ripgrep"    # grep replacement
brew "fd"         # find replacement
brew "fzf"        # fuzzy finder

# Optional but recommended
brew "tlrc"       # Simplified man pages (official Rust tldr client)
brew "git-delta"  # Better git diffs

# Required: eza --icons and starship's default prompt symbols are Nerd Font glyphs.
# Without this they render as tofu. Remember to select it in your terminal profile.
cask "font-hack-nerd-font"
